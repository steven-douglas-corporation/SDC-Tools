{
  "name": "sdc-state-logic-builder",
  "version": "3.4.1",
  "description": "SDC State Logic Diagram Builder - ME to L5X",
  "main": "electron/main.js",
  "scripts": {
    "start": "node server.js",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "serve": "node server.js",
    "electron:dev": "electron .",
    "electron:build": "electron-builder --win portable",
    "electron:installer": "electron-builder --win nsis",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test tests/unit/*.test.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "@xyflow/react": "^12.11.6",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "electron-updater": "^6.8.9",
    "fast-xml-parser": "^5.11.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.24.4",
    "nanoid": "^5.0.7",
    "pdf-parse": "^2.4.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@vitejs/plugin-react": "^4.4.1",
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "prettier": "^3.9.6",
    "vite": "^6.3.5"
  },
  "build": {
    "appId": "com.sdc.statelogicbuilder",
    "productName": "SDC State Logic Builder",
    "files": [
      "electron/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist",
        "to": "dist"
      },
      {
        "from": "server.js",
        "to": "server.js"
      },
      {
        "from": "public/icon.ico",
        "to": "icon.ico"
      }
    ],
    "win": {
      "icon": "public/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SDC State Logic Builder",
      "artifactName": "SDC-State-Logic-Builder-Setup-${version}.exe",
      "include": "build/installer.nsh"
    },
    "publish": {
      "provider": "github",
      "owner": "danbelliveau2",
      "repo": "state_logic_builder",
      "releaseType": "release"
    },
    "directories": {
      "output": "release"
    }
  }
}
