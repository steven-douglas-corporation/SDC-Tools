{
  "name": "sdc-state-logic-builder",
  "version": "3.4.1",
  "description": "SDC State Logic Diagram Builder - ME to L5X",
  "main": "electron/main.js",
  "scripts": {
    "start": "node server.js",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "serve": "node server.js",
    "electron:dev": "electron .",
    "electron:build": "electron-builder --win portable",
    "electron:installer": "electron-builder --win nsis",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test tests/unit/*.test.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "@xyflow/react": "^12.3.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.0",
    "electron-updater": "^6.8.3",
    "fast-xml-parser": "^5.11.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.11.0",
    "nanoid": "^6.0.1",
    "pdf-parse": "^2.4.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.4.2",
    "electron-builder": "^26.15.3",
    "eslint": "^10.10.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "vite": "^8.3.0"
  },
  "build": {
    "appId": "com.sdc.statelogicbuilder",
    "productName": "SDC State Logic Builder",
    "files": [
      "electron/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist",
        "to": "dist"
      },
      {
        "from": "server.js",
        "to": "server.js"
      },
      {
        "from": "public/icon.ico",
        "to": "icon.ico"
      }
    ],
    "win": {
      "icon": "public/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SDC State Logic Builder",
      "artifactName": "SDC-State-Logic-Builder-Setup-${version}.exe",
      "include": "build/installer.nsh"
    },
    "publish": {
      "provider": "github",
      "owner": "danbelliveau2",
      "repo": "state_logic_builder",
      "releaseType": "release"
    },
    "directories": {
      "output": "release"
    }
  }
}
