{
  "name": "sdc-assemblies-library",
  "version": "1.0.25",
  "repository": {
    "type": "git",
    "url": "https://github.com/steven-douglas-corporation/SDC-Tools.git"
  },
  "type": "commonjs",
  "main": "electron/main.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "node server/index.js",
    "client": "vite client",
    "build": "vite build client",
    "electron:dev": "cross-env NODE_ENV=development concurrently \"npm run server\" \"npm run client\" \"wait-on http://localhost:5173 && wait-on http://localhost:3001 && electron .\"",
    "electron:build": "npm run build && electron-builder",
    "test": "vitest run --config vitest.unit.config.mjs",
    "test:watch": "vitest --config vitest.config.mjs",
    "test:api": "vitest run --config vitest.config.mjs tests/api",
    "test:e2e": "playwright test --config playwright.config.mjs",
    "test:e2e:ui": "playwright test --config playwright.config.mjs --ui",
    "test:all": "npm run test && npm run test:e2e",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "vitest run --config vitest.unit.config.mjs",
    "test:integration": "vitest run --config vitest.config.mjs"
  },
  "build": {
    "appId": "com.sdc.assemblies-library",
    "productName": "SDC Assemblies Library",
    "directories": {
      "output": "dist-build"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "steven-douglas-corporation",
        "repo": "SDC-Tools",
        "channel": "assemblies",
        "releaseType": "release"
      }
    ],
    "asar": true,
    "asarUnpack": [
      "server/**/*",
      "client/dist/**/*",
      "**/node_modules/mysql2/**/*"
    ],
    "files": [
      "client/dist/**/*",
      "server/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "client/public/app-icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "runAfterFinish": true
    }
  },
  "dependencies": {
    "concurrently": "^10.0.5",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "electron-updater": "^6.8.3",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.11.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.59.1",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.4.19",
    "cross-env": "^10.1.0",
    "electron": "44.3.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.10.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "postcss": "^8.4.38",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.0",
    "wait-on": "^9.0.5"
  }
}
