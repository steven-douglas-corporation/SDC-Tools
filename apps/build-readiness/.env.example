# ETO Database (SQL Server)
ETO_HOST=your-server-here
ETO_DATABASE=your-database-here
ETO_USER=your-user-here
ETO_PASSWORD=your-password-here
ETO_DOMAIN=stevendouglas
ETO_PORT=1433

# SDC Scheduler — source of build-start/ship dates (replaced the old Smartsheet
# integration, now removed entirely). MUST match the same READINESS_SHARED_TOKEN
# value in SDC_Scheduler/.env.
SCHEDULER_URL=http://localhost:4003
READINESS_SHARED_TOKEN=change-this-to-a-random-64-char-string

# App
PORT=3000

# ─── SDC Tools centralized session (SSO) ─────────────────────────────────────
# Shared secret used to verify the "sdc_session" cookie minted by SDC
# Scheduler's central SSO after the SDC Tools shell's Azure AD login. Same
# value must be set on every SDC Tools app (Scheduler, Assemblies Library,
# Build Readiness Report, State Logic Builder, Calendar). Do not invent a
# value here — get the real one from wherever the other apps' secrets live.
# SDC_SESSION_SECRET=

# Set to 'true' to require a valid sdc_session cookie on every route except
# /health. Defaults to unset/false — no behavior change until explicitly
# enabled here.
# SDC_SSO_ENABLED=true

# ─── SDC Projects Reports app (apps/reports) ───────────────────────────────
# Source of truth for the Readiness tab's Delivery Slip / No Purchase Order /
# Upcoming Deliveries cards — this app reads them from the Reports app's
# /api/integration/jobs/:id/procurement endpoint instead of deriving its own
# (see server/services/plannerClient.js for why). Leave unset and the three
# cards render an explicit "unavailable" state; nothing else is affected.
# SCHEDULER_SHARED_TOKEN must match the Reports app's own value.
ETC_PLANNER_URL=http://localhost:4006
SCHEDULER_SHARED_TOKEN=change-this-to-match-the-reports-app
