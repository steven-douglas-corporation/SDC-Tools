+  assert.equal(isConfirmedEntry({ needsReview: true, submittedAt: AT }), true); // reopened
+  assert.equal(isConfirmedEntry({ needsReview: true, submittedAt: null }), false); // never submitted — the seed in newEtc is not a decision
+});
