+// ── A locked month accepts no draft write (2026-09-14) ──────────────────────
+//
+// saveAllNewEtcDrafts had no lock check at all. Its per-row loop skipped frozen
+// rows, so an existing cell could not be written — but a cell with NO row yet
+// (`newEtcCreate__…`) went through `upsert … create: { needsReview: true }`, and a
+// tab rendered before the submission would post one on blur. One pending row in a
+// frozen month flips isMonthLocked to false: the receipt vanishes, the Standard
+// Sheet snapshot is still there, and the next month cannot be started because
+// assertMonthSeedable now sees "still in progress". The month is half-unlocked by
+// a keystroke nobody meant as a reopen.
+//
+// One function so the save action, the test and the message agree. Called before
+// any write is prepared AND again inside the write transaction, because a
+// submission can land between the two.
+export function assertMonthNotLocked(month: string, entries: { needsReview: boolean }[]): void {
+  if (isMonthLocked(entries)) {
+    throw new Error(`${month} is submitted and locked — nothing was saved. Reopen the month before editing it.`);
