# Copy to .env and fill in real values (ask a teammate — nothing here is a
# real secret). See docs/DEVELOPMENT.md for what each of these actually does.
# Never commit .env or any filled-in copy of this file.

# This app's own MySQL connection (Prisma)
DATABASE_URL=

# NextAuth session signing; also used to derive the password-gate cookies
AUTH_SECRET=
# The externally-visible URL NextAuth should use for callbacks
AUTH_URL=

# Total ETO (MSSQL) domain credentials
TOTALETO_DB_USER=
TOTALETO_DB_PASSWORD=

# Power BI / Fabric service principal
PBI_TENANT_ID=
PBI_CLIENT_ID=
PBI_CLIENT_SECRET=
# Which Power BI dataset to query (legacy paths only)
PBI_WORKSPACE_ID=
PBI_DATASET_ID=

# The DataWarehouse (PostgreSQL), read-only login reports_app, e.g.
#   postgres://reports_app:<password>@localhost:5432/DataWarehouse
# Set = Paylocity hours, the roster and Position_Families are read from the
# warehouse, and the JOB_HOURS / PAYLOCITY_EMPLOYEES / PAYLOCITY_POSITION_FAMILIES
# paths below are ignored (the files are deleted from the SFTP share since
# 2026-10-04). The overrides file is still read from its path.
DATAWAREHOUSE_URL=

# Filesystem path to the OneDrive-synced Paylocity workbook
JOB_HOURS_LOCAL_PATH=
# Override to force `power_bi` instead of the workbook (rare -- CLI/debug use)
HOURS_SOURCE=

# Folder scanned for Lisa's monthly *inventory*.xlsx workbook (Job Cost
# Explorer's %Complete/Sales$) -- defaults to a hardcoded OneDrive path if unset
JOB_COST_INVENTORY_FOLDER=
# Filesystem path to the Paylocity Recruiting export read live on every
# /employees render -- defaults to a hardcoded OneDrive path if unset
HIRING_POSITIONS_LOCAL_PATH=
# Filesystem path to the Paylocity employee roster file (Employee Id, names, Job
# Title, Supervisor's Employee ID, Is Active). Synced hourly: adds new people
# hidden and mirrors supervisor + job title. Unset = the step is skipped.
PAYLOCITY_EMPLOYEES_LOCAL_PATH=
# Paylocity's Position_Families report (Family Code, Family Name, Position Code,
# Title, Total Headcount). Synced hourly into the PositionFamily table, just
# before the roster. Unset = the step is skipped.
PAYLOCITY_POSITION_FAMILIES_LOCAL_PATH=
# Our overrides file, same layout. A row replaces Paylocity's rows for its
# position code. Optional, but once set a missing file fails the step.
PAYLOCITY_POSITION_FAMILY_OVERRIDES_LOCAL_PATH=

# Read-only MySQL into the sibling Scheduler app's database
SCHEDULER_DATABASE_URL=
# Bearer token for the two apps' server-to-server integration routes
SCHEDULER_SHARED_TOKEN=
# Where to send a user for the Scheduler-SSO handoff
SCHEDULER_BASE_URL=

# Per-gate override of the shared "button password" for Reopen Month (falls
# back to a shared default if unset) -- Projects/Standard Sheet/Audit Log
# access is a role check now (src/lib/permissions.ts), not a password
CONFIRM_PASSWORD=

# Configures which signed-in users may tick off which department's ETC sign-off
ETC_DEPARTMENT_OWNERS=

# Displayed in the sidebar
NEXT_PUBLIC_APP_VERSION=
