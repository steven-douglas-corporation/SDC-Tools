{
  "name": "sdc-reports",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 4006",
    "dev:preview": "set NEXT_DIST_DIR=.next-preview&& next dev",
    "dev:preview2": "set NEXT_DIST_DIR=.next-preview2&& next dev",
    "build": "next build",
    "start": "next start -p 4006",
    "free-port": "node scripts/free-port.mjs 4006",
    "deploy": "next build && pm2 stop sdc-reports && node scripts/free-port.mjs 4006 && pm2 start sdc-reports",
    "lint": "eslint",
    "test": "tsx -r ./scripts/shim-server-only.cjs --test tests/*.test.ts",
    "dev:verify": "set AUTH_URL=http://localhost:3021&& set NEXT_DIST_DIR=.next-verify&& next dev -p 3021"
  },
  "dependencies": {
    "@azure/msal-node": "^5.3.1",
    "@azure/msal-node-extensions": "^5.3.1",
    "@prisma/client": "6.19.3",
    "ag-grid-community": "^36.0.2",
    "ag-grid-react": "^36.0.2",
    "bcryptjs": "^3.0.3",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.6",
    "exceljs": "^4.4.0",
    "mssql": "^12.6.0",
    "mysql2": "^3.23.1",
    "next": "16.2.9",
    "next-auth": "^5.0.0-beta.32",
    "prisma": "6.19.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "unpdf": "^1.6.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/mssql": "^12.3.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^10",
    "eslint-config-next": "16.2.9",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^7",
    "xlsx": "^0.18.5"
  }
}
