{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    ".next-preview/types/**/*.ts",
    ".next-preview/dev/types/**/*.ts",
    ".next-preview2/types/**/*.ts",
    ".next-preview2/dev/types/**/*.ts",
    ".next-verify/types/**/*.ts",
    ".next-verify/dev/types/**/*.ts",
    ".next-buildcheck/types/**/*.ts",
    ".next-buildcheck/dev/types/**/*.ts",
    ".next-motioncheck/types/**/*.ts",
    ".next-motioncheck/dev/types/**/*.ts",
    ".next-verify3/types/**/*.ts",
    ".next-verify3/dev/types/**/*.ts",
    ".next-perf/types/**/*.ts",
    ".next-perf/dev/types/**/*.ts",
    ".next-audit/types/**/*.ts",
    ".next-audit/dev/types/**/*.ts",
    ".next-preview-audit/types/**/*.ts",
    ".next-preview-audit/dev/types/**/*.ts",
    ".next-ci/types/**/*.ts",
    ".next-ci/dev/types/**/*.ts",
    ".next-verify-build/types/**/*.ts",
    ".next-verify-build/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next-preview",
    ".next-preview2",
    ".next-verify",
    ".next-verify2",
    ".next-buildcheck"
  ]
}
