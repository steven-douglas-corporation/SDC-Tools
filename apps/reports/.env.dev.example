# Local development profile for SDC Reports. Copy to .env:
#   cp .env.dev.example .env
# Everything here points at the throwaway Docker database from
# docker-compose.dev.yml. Nothing here is a real secret and nothing reaches
# production. Walkthrough: docs/DEV-ENVIRONMENT.md (repo root).

# The Docker MySQL (host port 3317, database sdc_reports_dev).
DATABASE_URL="mysql://root:devpassword@127.0.0.1:3317/sdc_reports_dev"

# Any long random string works locally; sessions signed with it are only valid here.
AUTH_SECRET="dev-only-not-a-secret-change-me-to-anything-long"
AUTH_URL="http://localhost:4006"

# ── Safety switch ───────────────────────────────────────────────────────────
# Turns off the hourly auto-refresh and the "Refresh Data" button. Without it
# the app tries to pull from Total ETO / Power BI / the DataWarehouse / the
# Paylocity files on boot and may overwrite or purge the dataset you seeded.
# Leave this on unless you are deliberately testing the sync pipeline.
SDC_DEV_DISABLE_SYNC=1

# ── Deliberately left blank ─────────────────────────────────────────────────
# Leaving these unset is what keeps a dev build away from production systems.
# Do NOT paste production values here.
#   TOTALETO_DB_USER / TOTALETO_DB_PASSWORD   Total ETO (company SQL Server)
#   PBI_*                                     Power BI / Fabric
#   DATAWAREHOUSE_URL                         the company DataWarehouse
#   SCHEDULER_DATABASE_URL / SCHEDULER_SHARED_TOKEN / SCHEDULER_BASE_URL
#   *_LOCAL_PATH                              Paylocity / inventory workbooks

# Fake Total ETO parts feed (dev-only): serves generated PO lines to the parts-cost,
# left-to-invoice and parts-list code instead of querying the company SQL Server.
SDC_DEV_FAKE_ETO=1
