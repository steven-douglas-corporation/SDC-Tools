{
  "name": "sdc-centralized-calendar",
  "version": "1.2.6",
  "description": "SDC Automation Centralized Calendar — desktop app",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --enable-logging",
    "build": "electron-builder build --windows",
    "publish": "electron-builder build --windows -p always",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:web": "vite build",
    "test": "node --test \"tests/unit/*.test.mjs\""
  },
  "build": {
    "appId": "com.sdc.calendar",
    "productName": "SDC Calendar",
    "copyright": "Copyright © 2026 SDC",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "frontend/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "frontend/icons/sdc-calendar-icon-C-new.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SDC Calendar"
    },
    "publish": {
      "provider": "github",
      "owner": "steven-douglas-corporation",
      "repo": "SDC-Tools",
      "channel": "calendar",
      "releaseType": "release"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^29.0.0",
    "electron-builder": "^26.8.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "prettier": "^3.9.6",
    "vite": "^6.4.3"
  },
  "dependencies": {
    "nodemailer": "^8.0.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sqlite3": "^6.0.1",
    "xlsx": "^0.18.5"
  }
}
